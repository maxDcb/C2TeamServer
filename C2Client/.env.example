# Copy this file to C2Client/.env and adjust local values.
# Values already present in the process environment take precedence.
# Relative paths are resolved from the directory containing this .env file.

# TeamServer connection
C2_IP=127.0.0.1
C2_PORT=50051
C2_DEV_MODE=false
C2_CERT_PATH=
C2_USERNAME=
C2_PASSWORD=

# Generated protocol bindings
C2_PROTOCOL_PYTHON_ROOT=

# Client UI
C2_UI_THEME=dark
C2_SESSION_REFRESH_MS=2000
C2_SESSION_STALE_AFTER_MS=30000
C2_LISTENER_REFRESH_MS=2000
C2_GRAPH_REFRESH_MS=2000
C2_LOG_DIR=
C2_LOG_LEVEL=WARNING

# gRPC
C2_GRPC_CONNECT_TIMEOUT_MS=10000
C2_GRPC_MAX_MESSAGE_MB=512

# OpenAI provider
OPENAI_API_KEY=

# Assistant models
C2_ASSISTANT_MODEL=gpt-4.1-mini
C2_ASSISTANT_MEMORY_MODEL=gpt-4.1-mini

# Optional OpenAI-compatible aliases used as fallbacks
# OPENAI_MODEL=gpt-4o
# OPENAI_MEMORY_MODEL=gpt-4.1-mini

# Assistant runtime tuning
C2_ASSISTANT_TEMPERATURE=0.05
C2_ASSISTANT_MEMORY_TEMPERATURE=0.05
C2_ASSISTANT_MAX_TOOL_CALLS=10
C2_ASSISTANT_MAX_ACTIVE_CONTEXT_TOKENS=64000
C2_ASSISTANT_LOG_SYNTHESIS_PAYLOADS=false
# Accepted assistant commands wait for an explicit result or a manual /stop.

# Agent-core stores exact tool results under the assistant's artifacts directory.
# Defaults are used when these optional byte and read limits are unset.
# Large results appear as a preview with an artifact ID; the assistant can read
# further chunks with its native agent_core_read_artifact tool.
# C2_ASSISTANT_ARTIFACT_HOT_CONTEXT_BYTES=65536
# C2_ASSISTANT_ARTIFACT_MAX_COMPLETE_RESULT_BYTES=32768
# C2_ASSISTANT_ARTIFACT_PREVIEW_BYTES=4096
# C2_ASSISTANT_ARTIFACT_MAX_READ_BYTES=16384
# C2_ASSISTANT_ARTIFACT_MAX_READS_PER_RUN=20
# C2_ASSISTANT_ARTIFACT_MAX_TOTAL_READ_BYTES=262144
# C2_ASSISTANT_ARTIFACT_MAX_NAVIGATION_SOURCE_BYTES=8388608
# C2_ASSISTANT_ARTIFACT_MAX_NAVIGATION_CACHE_BYTES=16777216

# Local modules
C2_DROPPER_MODULES_DIR=
C2_DROPPER_MODULES_CONF=
C2_SHELLCODE_MODULES_DIR=
C2_SHELLCODE_MODULES_CONF=
